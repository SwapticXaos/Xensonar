nst ctx={\n  myzelGClamp:x=>Math.max(0,Math.min(1,Number.isFinite(x)?x:0)),\n  __xenGridMuted:()=>false,pEe:()=>rows,gj:()=>({min:100,max:300}),tc:100,\n  P:{},Set,Map,Object,Math,Number\n};\nvm.createContext(ctx);\nvm.runInContext(src+'\\nglobalThis.__testGrid=__NodalBallGrid;',ctx,{timeout:2500});\nconst api=ctx.__testGrid;\nconst params={gridTuning:'12edo'};\napi.bind({paramsRef:{current:params},modeRef:{current:'installation'},mixRef:{current:{ballToneMode:'grid'}}});\nconst mix={ballToneMode:'grid',rootLevel:.62,ballToneLevel:1};\nconst at=y=>({cursorNormalizedY:y});\nconst s={};\nassert.equal(api.control(at(.4),mix,s,1).gate,0,'Cold initialization must not replay a crossing');\nconst hit=api.control(at(.6),mix,s,1.015);\nassert.equal(hit.hz,200,'Line crossing must select the correct precompiled frequency');\nassert(hit.gate>0,'Fresh line crossing must produce audible gate');\nconst quiet=api.control(at(.61),{...mix,ballToneLevel:0},s,1.020);\nassert.equal(quiet.gate,0,'Ball-tone mute must silence the grid gate');\nassert.equal(quiet.hz,hit.hz,'Mute must not erase chosen pitch');\nconst delayed=api.control(at(.2),mix,s,2.0);\nassert.equal(delayed.gate,0,'A stalled frame must not replay accumulated line events');\nconsole.log('PASS installation Ball Grid crossing, mute, pitch continuity and no late catch-up');\n// Separate audio-domain checks without mutating DSP: ensure ball tone gain reaches\n// both fallback voices and actual native DSP, while resident voices stay independent.\nconst fallback=fs.readFileSync(path.join(root,'src/audio/08_myzel_g_live.js'),'utf8');\nconst dsp=fs.readFileSync(path.join(root,'src/audio/09_myzel_g_dsp.js'),'utf8');\nassert.match(fallback,/rootLevel\\*\\.05\\*ballTone\\.gate\\*ballToneLevel/,'Native fallback ball-tone gain missing');\nassert.match(fallback,/ballLevel\\*\\(\\.006\\+g\\.gestureEnergy\\*\\.08\\)\\*ballToneLevel/,'Native fallback ball motion gain missing');\nassert.match(dsp,/gains\\[0\\]=t\\.rootLevel\\*\\.21\\*t\\.ballToneGate\\*t\\.ballToneLevel/,'DSP root/ball gain missing');\nassert.match(dsp,/gains\\[1\\]=t\\.ballLevel\\*.*\\*t\\.ballToneLevel/,'DSP ball reaction gain missing');\nassert.match(dsp,/gains\\[2\\]=t\\.nodeLevel\\*t\\.presence/,'Resident voice must remain independent of ball-tone mute');\nconsole.log('PASS independent resident-gain boundary, native/Worklet ball-tone muting present');\n"}]},{"path":"tests/p7_2_patch_ancestry.cjs","before_sha256":null,"after_sha256":"a827b21dd6753b8b105bcda5219abeb6a48ef7124501f0554ddeda8ec5824abd","before_chars":0,"after_chars":2745,"new_file":true,"edits":[{"at":0,"delete":0,"insert":"'use strict';\n// Independent, read-only witness: replay every declared source span in memory\n// from the user's original Codex basis and compare to the patched checkout.\n// Unlike hash-whitelisting, this fails on any additional or altered byte.\nconst fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),assert=require('node:assert/strict');\nconst patched=path.resolve(process.argv[2]||'.');\nconst original=process.argv[3]&&path.resolve(process.argv[3]);\nconst patchDir=process.argv[4]&&path.resolve(process.argv[4]);\nassert(original&&patchDir,'Usage: node tests/p7_2_patch_ancestry.cjs <patched-root> <original-root> <handoff-patches>');\nconst sha=v=>crypto.createHash('sha256').update(v).digest('hex');\nconst read=(root,file)=>fs.readFileSync(path.join(root,file),'utf8');\nconst stages=fs.readdirSync(patchDir).filter(x=>/^0[0-8]_.*\\.xpatch\\.json$/.test(x)).sort();\nassert.equal(stages.length,9,'Exactly nine functional stages must be represented');\nconst simulated=new Map();let edits=0,files=0;\nfor(const filename of stages){\n const patch=JSON.parse(fs.readFileSync(path.join(patchDir,filename)));\n for(const f of patch.files){\n  const previous=simulated.has(f.path)?simulated.get(f.path):f.new_file?'':read(original,f.path);\n  assert.equal(sha(previous),f.before_sha256||sha(''),`Unexpected predecessor of ${filename}: ${f.path}`);\n  // xpatch offsets were generated by Python and index Unicode code points,\n  // NOT JavaScript UTF-16 units (astral emoji must remain position-safe).\n  let points=Array.from(previous);\n  for(const edit of [...f.edits].reverse()){\n   assert(edit.at>=0&&edit.at+edit.delete<=points.length,'Invalid patch span');\n   points.splice(edit.at,edit.delete,...Array.from(edit.insert));\n   edits++;\n  }\n  const result=points.join('');\n  assert.equal(sha(result),f.after_sha256,`Unexpected output of ${filename}: ${f.path}`);\n  simulated.set(f.path,result);files++;\n }\n}\nfor(const [file,result] of simulated){\n assert.equal(read(patched,file),result,`Unauthorized source difference: ${file}`);\n}\nconst manifestOld=JSON.parse(read(original,'source-manifest.json'));\nconst manifestNew=JSON.parse(read(patched,'source-manifest.json'));\nassert.deepEqual(manifestNew.files.slice(1),manifestOld.files,'Existing source order must not change');\nassert.equal(manifestNew.files[0],'src/handoff/00_chat_feature_addons.js','Expected explicit one-file addition');\nassert.deepEqual(manifestNew.styles,manifestOld.styles,'Style order must remain unchanged');\nconsole.log(`PASS provenance from actual Codex baseline through 00-08: ${files} file applications, ${edits} exact edits, ${simulated.size} distinct modules`);\nconsole.log('PASS no unreviewed source-span drift in declared modules or assembly order');\n"}]},{"path":"tests/p7_2_source_index_freshness.cjs","before_sha256":null,"after_sha256":"dd39b2f36f8f82654a165ee3d87f1e61594dc006d7708b687a1e43b55a1ae496","before_chars":0,"after_chars":1921,"new_file":true,"edits":[{"at":0,"delete":0,"insert":"'use strict';\n// Read-only fresh-index gate. Uses repository TypeScript when installed, with\n// global TypeScript only as an explicit fallback for the isolated QA environment.\nconst fs=require('node:fs'),path=require('node:path'),os=require('node:os'),cp=require('node:child_process'),assert=require('node:assert/strict');\nconst root=path.resolve(process.argv[2]||'.');\nconst tempfile=fs.mkdtempSync(path.join(os.tmpdir(),'p72-index-'));\ntry{\n fs.mkdirSync(path.join(tempfile,'tools'));\n fs.copyFileSync(path.join(root,'tools/source_index.cjs'),path.join(tempfile,'tools/source_index.cjs'));\n fs.copyFileSync(path.join(root,'source-manifest.json'),path.join(tempfile,'source-manifest.json'));\n fs.symlinkSync(path.join(root,'src'),path.join(tempfile,'src'),'dir');\n const local=path.join(root,'node_modules');\n if(fs.existsSync(local))fs.symlinkSync(local,path.join(tempfile,'node_modules'),'dir');\n const globalModules=cp.execFileSync('npm',['root','-g'],{encoding:'utf8'}).trim();\n const exec=cp.spawnSync(process.execPath,[path.join(tempfile,'tools/source_index.cjs')],{\n   cwd:tempfile,encoding:'utf8',timeout:60000,env:{...process.env,NODE_PATH:[local,globalModules,process.env.NODE_PATH||''].join(path.delimiter)}\n });\n assert.equal(exec.status,0,`Index generation failed: ${exec.stderr||exec.stdout}`);\n const expected=fs.readFileSync(path.join(tempfile,'source-index.json'),'utf8');\n const current=fs.readFileSync(path.join(root,'source-index.json'),'utf8');\n assert.equal(current,expected,'source-index.json is stale: regenerate with npm run map:sources');\n const index=JSON.parse(current);assert(index.declarations.some(x=>x.file==='src/handoff/00_chat_feature_addons.js'),'New tuning/keyboard addon missing in index');\n console.log(`PASS fresh source-index: ${index.declarations.length} declarations / ${index.dependencies.length} file dependencies`);\n}finally{fs.rmSync(tempfile,{recursive:true,force:true})}\n"}]}]}
