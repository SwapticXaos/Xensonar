+}
 @media(min-width:1001px){.f31-play-rack .f34-transport-status{width:min(345px,55%);max-width:345px}}
 @media(max-width:1000px){.f35-navigator-save-slot{position:static;margin-top:4px}.f35-navigator-save-slot:empty{display:none}}
+
+/* P7.3: audibly timed navigator-region scan, compositor transform only. */
+.forge-navigator-region-sweep{
+ position:absolute;inset:0;width:100%;height:100%;pointer-events:none;
+ animation:forge-navigator-region-sweep var(--forge-region-preview-duration,1s) linear both;
+ will-change:transform;
+}
+.forge-navigator-region-playhead{
