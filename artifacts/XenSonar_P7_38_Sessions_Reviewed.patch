+}
+.xen-meta-tab-assembly[data-xen-meta-tab-mode="sessions"] .xen-meta-session-backtab{
+  /* The live rear folder spans the whole front-tab row and touches the pane.
+     Its uninterrupted colour shows through the gaps between the teeth. */
+  top:-5px;height:42px;border:2px solid #82dfed;border-bottom:0;
+  color:#e1fbff;background:linear-gradient(180deg,#29647f 0%,#1c4c64 70%,#12354a 100%);
+  box-shadow:0 0 0 1px #3a8296 inset,0 -3px 13px #45b7cf24;
+}
+.xen-meta-tab-assembly[data-xen-meta-tab-mode="sessions"] .xen-meta-tabs>button{
+  /* Opaque teeth: the Sessions layer is revealed only in the gaps. */
+  margin-inline:4px;color:#71869a;
+  background:#0b1927;border-color:#253e51;
+}
+/* No horizontal divider across the middle openings: the raised Sessions
+   supertab visually becomes the top edge of the selected session list. */
+.xen-meta-tab-assembly[data-xen-meta-tab-mode="sessions"] + .xen-meta-session-manager{
+  border-top:0;
+  background:linear-gradient(to bottom,#12354a 0px,#12354a 8px,#0d1d2c 36px);
+}
+
+.xen-meta-tab-assembly[data-xen-meta-tab-mode="sessions"] .xen-meta-tabs>button:hover,
+.xen-meta-tab-assembly[data-xen-meta-tab-mode="sessions"] .xen-meta-tabs>button:focus-visible{
