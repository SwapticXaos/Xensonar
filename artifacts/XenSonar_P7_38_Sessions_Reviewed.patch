+
+/* Session supertab has two real interaction states.
+   The front row stays in the same grid: no target-coordinate jump or extra row.
+   When managing Sessions, all five source tabs retract into separated "teeth".
+   Switching to a material tab restores their full width and lowers the supertab. */
+.xen-meta-tab-assembly .xen-meta-session-backtab,
+.xen-meta-tab-assembly>.xen-meta-tabs,
+.xen-meta-tab-assembly>.xen-meta-tabs>button{
+  transition:top 160ms ease,height 160ms ease,background-color 160ms ease,
+    border-color 160ms ease,color 160ms ease,margin-inline 160ms ease,
+    opacity 160ms ease,box-shadow 160ms ease;
+}
+.xen-meta-tab-assembly[data-xen-meta-tab-mode="libraries"] .xen-meta-session-backtab{
+  top:7px;height:30px;border-color:#376681;
+  background:linear-gradient(180deg,#19394c 0%,#152e40 75%,#102536 100%);
