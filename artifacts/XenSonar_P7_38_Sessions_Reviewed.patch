+.xen-meta-browser-heading{position:relative;z-index:3;flex-wrap:wrap;gap:8px;padding:15px 11px 11px;min-height:61px;box-sizing:border-box;overflow:visible}
+.xen-meta-browser-heading .xen-meta-library-open-manager{flex:0 0 188px;width:188px;min-width:0;max-width:100%;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3;box-sizing:border-box;padding:7px 8px;border-radius:6px;border:1px solid #a78bfa;background:#4c316c;color:#ede9fe;font-weight:700;cursor:pointer;transition:background 140ms ease,border-color 140ms ease,color 140ms ease}
+.xen-meta-browser-heading .xen-meta-library-open-manager:hover,.xen-meta-browser-heading .xen-meta-library-open-manager:focus-visible{background:#4c316c;border-color:#a78bfa;color:#f5f3ff;filter:brightness(1.20)}
