+
+/* Prototype-A drag fidelity: out-of-flow insertion line. No row/layout shift. */
+.xen-meta-lane-items{position:relative;}
+.xen-meta-insertion-line{position:absolute;z-index:6;left:4px;right:4px;height:3px;
+ background:#74f2fb;box-shadow:0 0 0 1px #174b63,0 0 9px #2bd5f1b5;
+ border-radius:2px;pointer-events:none;}
+
+/* P7.28: interactive rear Sessions tab opens the saved-session manager;
+   source tabs remain independently usable in the front layer. */
+.xen-meta-tab-assembly{position:relative;margin:0 13px 0;padding-top:35px;min-width:0;isolation:isolate}
+.xen-meta-session-backtab{position:absolute;z-index:0;cursor:pointer;top:0;left:0;right:0;height:39px;box-sizing:border-box;display:flex;justify-content:center;align-items:flex-start;padding:5px 11px 0;border:1px solid #366a84;border-bottom:0;border-radius:9px 9px 0 0;background:linear-gradient(180deg,#18384d 0%,#142b3e 75%,#102536 100%);color:#ade5f3;font:700 12px/20px system-ui,sans-serif;letter-spacing:.035em}
+.xen-meta-session-backtab-label{display:inline-flex;justify-content:center;align-items:center;gap:5px;white-space:nowrap;line-height:20px;pointer-events:none}
+.xen-meta-tab-assembly>.xen-meta-tabs{z-index:1;position:relative;padding:0;gap:3px;margin-bottom:-1px}
+.xen-meta-tab-assembly>.xen-meta-tabs>button{border-color:#376078;border-bottom-color:#3f6d86;background:#19354a;min-height:37px}
+.xen-meta-tab-assembly>.xen-meta-tabs>button[aria-selected=true]{background:#0d1d2c;border-color:#4ab4cd;border-bottom-color:#0d1d2c}
+.xen-meta-tab-assembly+.xen-meta-browser{border-top-color:#3e6c87}
+@media(max-width:1080px){.xen-meta-tab-assembly{margin:0 7px 0}}
+@media(max-width:760px){.xen-meta-tab-assembly{margin:0 4px 0;padding-top:35px}.xen-meta-session-backtab{height:39px;padding:5px 8px 0}.xen-meta-tab-assembly>.xen-meta-tabs{gap:1px}.xen-meta-tab-assembly>.xen-meta-tabs>button{min-height:39px}}
+
+/* Keep the *clickable* button within the fully exposed header band.
+   The non-interactive rear plate bridges behind opaque tabs all the way to
+   the session list. A full-height button would have its center covered by
+   foreground tabs and become unreachable to ordinary pointer/automation. */
+.xen-meta-session-backtab::after{content:"";position:absolute;top:calc(100% - 1px);left:-1px;right:-1px;height:50px;
+  background:inherit;border:1px solid currentColor;border-top:0;border-bottom:0;
+  pointer-events:none;opacity:.95}
+.xen-meta-tab-assembly[data-xen-meta-tab-mode="libraries"] .xen-meta-session-backtab::after{border-color:#376681}
+.xen-meta-tab-assembly[data-xen-meta-tab-mode="sessions"] .xen-meta-session-backtab::after{left:-2px;right:-2px;border-color:#82dfed}
