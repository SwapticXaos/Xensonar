+ P:{useSyncExternalStore:(_subscribe,snapshot)=>snapshot(),useState:init=>{let i=offset++;if(!(i in persistent))persistent[i]=init;return[persistent[i],x=>{persistent[i]=x}]},useRef:()=>({current:null}),useEffect:()=>{}},
