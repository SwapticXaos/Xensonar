+ Object.assign(context,vm.runInContext('(()=>{'+prefix+';return {__xenGridUid,__xenGridKey,__xenGridProfile,__xenGridCompatibleMode,__xenGridModeName}})()',context));
+ context.__xenQuickEntryTitle??=entry=>entry.name;
