+.xen-meta-tile-preview{box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;flex:0 0 18px;width:18px;height:19px;min-width:18px;padding:0!important;margin:0!important;border:1px solid #577287;border-radius:2px;background:#102537;color:#bfe6f2;font:600 10px/1 Arial,sans-serif;cursor:pointer}
+.xen-meta-tile-preview:hover:not(:disabled){border-color:#6aafca;background:#23475b;color:#f0fcff}
+.xen-meta-tile-preview[aria-pressed=true]{border-color:#b4c7d8;background:#24364d;color:#fff}
+.xen-meta-tile-preview:disabled{opacity:.4;cursor:default}
+.xen-meta-library-row .xen-meta-row-preview{flex:0 0 22px;width:22px;height:23px;min-height:0;padding:0;border:1px solid #41657f;border-radius:2px;background:#122e40;color:#91e4f1;font:600 11px/1 Arial,sans-serif}
+.xen-meta-library-row .xen-meta-row-preview:hover:not(:disabled){background:#235468}
+@media(max-width:760px){.xen-meta-browser-heading .xen-meta-library-open-manager{flex-basis:188px;width:min(188px,100%)}}
+/* At narrow widths the fixed-width violet link may wrap the Filter to a
