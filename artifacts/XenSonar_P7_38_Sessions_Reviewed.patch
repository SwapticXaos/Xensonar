+.xen-meta-browser-heading input{flex:0 1 130px;min-width:82px;width:130px;box-sizing:border-box}
+.xen-meta-browser-heading input:focus-visible{outline:2px solid #64dcfa;outline-offset:2px;position:relative;z-index:4}
+.xen-meta-browser-heading span{flex:0 0 auto}
+@media(max-width:760px){.xen-meta-browser-heading{padding:14px 7px 9px;gap:7px}.xen-meta-browser-heading .xen-meta-library-open-manager{flex-basis:188px;padding:7px 6px}.xen-meta-browser-heading input{flex-basis:95px;width:95px}}
+
+.xen-meta-action-arrow{display:inline-flex;position:relative;top:-2px;align-items:center;font:900 19px/1 Arial,sans-serif;vertical-align:middle;color:inherit}
+
+/* P7.34: index is a tiny corner marker, not a text column; the preview
