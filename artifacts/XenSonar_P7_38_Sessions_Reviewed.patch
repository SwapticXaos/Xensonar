+ context.__XenBassGrid??={normalize:value=>value&&typeof value==='object'?{...value}:{},subscribe:()=>()=>{},snapshot:()=>({})};
+ const quick=fs.readFileSync('src/mix/03_quick_menu.js','utf8');
