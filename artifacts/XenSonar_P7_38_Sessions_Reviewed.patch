+.xen-meta-source-menu svg path{fill:#4c316c;stroke:#a78bfa;stroke-width:1px;stroke-linejoin:miter;stroke-opacity:.52;opacity:1;transition:opacity 140ms ease,fill 140ms ease,stroke 140ms ease}
+.xen-meta-lane>header .xen-meta-source-menu:hover svg path,.xen-meta-lane>header .xen-meta-source-menu:focus-visible svg path{fill:#4c316c;stroke:#a78bfa;stroke-opacity:.92;opacity:1}
