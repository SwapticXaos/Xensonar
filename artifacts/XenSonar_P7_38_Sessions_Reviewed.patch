+.xen-meta-browser,.xen-meta-constellation{min-height:0}
+@media(max-height:520px){.xen-meta-editor{height:calc(100dvh - 12px);max-height:calc(100dvh - 12px)}
+ .xen-meta-overlay{padding:6px}.xen-meta-titlebar{padding-block:5px}
+ .xen-meta-head{min-height:37px;padding-block:5px}
+ .xen-meta-toolbar{padding-block:6px;min-height:0;gap:5px}
+ .xen-meta-footer{padding-block:5px;gap:5px}}
+
+/* P7.32 · Native manager sits above the retained Session editor (native z>=140).
+   Restore the normal z-index automatically when native quick-active closes. */
+.xen-meta-overlay.is-native-behind{z-index:100}
+.xen-meta-lane>header{position:relative;padding-right:0}
+/* P7.33: actual upper-right *half-square*, not a boxed dropdown chevron.
+   Geometry M2 2 H30 V30 Z => two equal 28-unit perpendicular legs,
+   hypotenuse from top-left to bottom-right. Border matches the 1px Session item borders. */
+.xen-meta-lane>header .xen-meta-source-menu{position:absolute;right:0;top:0;display:block;box-sizing:border-box;width:32px;height:32px;padding:0;border:0;border-radius:0;background:transparent;cursor:pointer;z-index:3}
