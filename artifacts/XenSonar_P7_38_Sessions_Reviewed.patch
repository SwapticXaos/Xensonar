+const metaText=fs.readFileSync(path.join(root,'src/mix/03_meta_menu.js'),'utf8');
+function section(src,first,last){const a=src.indexOf(first), b=src.indexOf(last,a);assert(a>=0 && b>a);return src.slice(a,b)}
+const snippet=section(quickText,'const __XenSongKinds=', '/* P4C2 UI:')+'\n'+section(metaText,'const __XenMetaLabels=','const __XenMetaSessions=')+'\nthis.make=__createXenMetaSessionStore;';
