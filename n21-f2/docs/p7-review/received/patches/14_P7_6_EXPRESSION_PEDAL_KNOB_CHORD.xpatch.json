      "edits": [
        {
          "at": 54986,
          "delete": 66,
          "insert": " // P7.6: B + LEFT Alt switches the expression gesture between temporary piano\n // pedals and a latched knob. The chord is consumed until BOTH keys are released.\n const [t,n]=P.useState({octave:!1,sustain:!1,swell:!1,damp:!1,expressionMode:'pedal'});\n"
        },
        {
          "at": 55128,
          "delete": 0,
          "insert": " const mode=P.useRef('pedal'),comboConsumed=P.useRef(!1);\n"
        },
        {
          "at": 55344,
          "delete": 210,
          "insert": " const updateExpressionHold=P.useCallback((which,held)=>{\n  const ref=which==='swell'?swellHeld:dampHeld;\n  const changed=ref.current!==held;ref.current=held;\n  if(held&&changed&&swellHeld.current&&dampHeld.current&&!comboConsumed.current){\n   comboConsumed.current=!0;\n   mode.current=mode.current==='pedal'?'knob':'pedal';\n   expression.current=0; // Do not carry the previous mode's trim into the new mode.\n  }\n  if(!swellHeld.current&&!dampHeld.current)comboConsumed.current=!1;\n  n(v=>v[which]===held&&v.expressionMode===mode.current?v:{...v,[which]:held,expressionMode:mode.current});\n },[]);\n const setSwell=P.useCallback(held=>updateExpressionHold('swell',held),[updateExpressionHold]);\n const setDamp=P.useCallback(held=>updateExpressionHold('damp',held),[updateExpressionHold]);\n"
        },
        {
          "at": 55723,
          "delete": 432,
          "insert": " const reset=P.useCallback(()=>{swellHeld.current=!1;dampHeld.current=!1;comboConsumed.current=!1;expression.current=0;octave.current=!1;sustain.current=!1;enter.current=!1;n({octave:!1,sustain:!1,swell:!1,damp:!1,expressionMode:mode.current})},[]);\n"
        },
        {
          "at": 56174,
          "delete": 167,
          "insert": "  if(!e){swellHeld.current=!1;dampHeld.current=!1;comboConsumed.current=!1;expression.current=0;return}\n  // The physical chord does not produce a volume gesture, and a latched knob\n  // at rest requires no RAF work at all.\n  if((comboConsumed.current||(!t.swell&&!t.damp))&&(mode.current==='knob'||Math.abs(expression.current)<.001)){\n   if(mode.current==='pedal'&&Math.abs(expression.current)<.001)expression.current=0;\n   return;\n  }\n"
        },
        {
          "at": 56451,
          "delete": 67,
          "insert": "   const direction=comboConsumed.current?0:(swellHeld.current?1:0)-(dampHeld.current?1:0);\n"
        },
        {
          "at": 56626,
          "delete": 153,
          "insert": "   }else if(mode.current==='pedal'){\n    const next=expression.current*Math.exp(-dt/42);\n"
        },
        {
          "at": 56835,
          "delete": 75,
          "insert": "   if(direction||(mode.current==='pedal'&&expression.current!==0))frame=requestAnimationFrame(tick);\n"
        },
        {
          "at": 57004,
          "delete": 24,
          "insert": " },[e,t.swell,t.damp,t.expressionMode]);\n"
        }
      ]
    },
