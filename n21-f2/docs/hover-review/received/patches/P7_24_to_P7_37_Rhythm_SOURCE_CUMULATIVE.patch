+vm.runInContext(snippet,context);
+const storageMap=new Map(); let fail=false;
+const storage={getItem:k=>storageMap.get(k)||null,setItem:(k,v)=>{if(fail)throw Error('quota');storageMap.set(k,v)}};
+let quickRows=[{kind:'grid',id:'17edo',name:'17 EDO'},{kind:'rootFollow',id:'rfl-a',name:'Root 5bar'}];
+let replaceCalls=0;const quick={getItems:()=>vm.runInContext(`JSON.parse(${JSON.stringify(JSON.stringify(quickRows))})`,context),replaceItems:()=>{replaceCalls++;}};
+const store=context.make(storage,quick);
+assert.equal(typeof store.saveFromQuickAsNew,'function','Disk shortcut must create a session from live quick access');
+assert.equal(typeof store.updateSavedFromQuick,'function','Disk shortcut must explicitly update a saved session');
+const first=store.saveFromQuickAsNew('Night Set'); assert.equal(first,true);
+let state=store.snapshot();assert.equal(state.saved.length,1);
+const firstRow=state.saved[0];assert.equal(firstRow.name,'Night Set');assert.equal(firstRow.items.length,2);
+assert.equal(state.items.length,2,'the editor working copy should remain unchanged');assert.equal(replaceCalls,0,'save must not change live playing state');
+assert.equal(store.saveFromQuickAsNew('night set'),false,'case-insensitive name collision must not silently overwrite');
+assert.equal(store.snapshot().saved.length,1);
+store.setItemColor({kind:'rootFollow',id:'rfl-a'},'border','#ff1144');
+assert.equal(store.use(),true); // apply session-local color to live palette
+quickRows.push({kind:'drum',id:'drum-5',name:'Five Steps'});
+const second=store.saveFromQuickAsNew('Bridge');assert.equal(second,true);
+state=store.snapshot();assert.equal(state.saved.length,2);assert.equal(state.saved[1].items.length,3);
+assert.equal(state.saved[1].colors['rootFollow\0rfl-a'].border,'#ff1144','new session retains live tint for existing matching references');
+const id=firstRow.id;
+quickRows=[{kind:'bass',id:'bass4',name:'Bass 4'}];
+const success=store.updateSavedFromQuick(id,'Night Set');assert.equal(success,true);
+state=store.snapshot();assert.equal(state.saved.length,2);assert.equal(state.saved.find(x=>x.id===id).items[0].id,'bass4');
+assert.equal(state.saved.find(x=>x.id===id).colors['rootFollow\0rfl-a'],undefined,'orphaned colors are pruned');
+assert.equal(store.updateSavedFromQuick('unknown-id','No'),false);assert.equal(store.snapshot().saved.length,2);
+assert.equal(store.updateSavedFromQuick(id,'Bridge'),false,'rename collision must not overwrite another project');
+fail=true;
+assert.equal(store.saveFromQuickAsNew('Quota Failure'),false,'failed storage must not update in-memory saved projects');
+assert.equal(store.snapshot().saved.length,2);
+fail=false;
+const reloaded=context.make(storage,quick);assert.equal(reloaded.snapshot().saved.length,2);
+assert.equal(reloaded.snapshot().saved.find(x=>x.id===id).items[0].id,'bass4');
+// Checkbox contract: default OFF never snapshots settings; ON captures live Main Room owner.
+const bridge=vm.runInContext('__XenMainRoomSessionBridge',context);
+const owner={nParamsUI:{gridTuning:'17edo',droneMixVolume:.31},waveSoundPreset:'tape_halo',waveSoundEnabled:true,waveSoundVolume:.24};
+const detach=bridge.attach(owner);
+assert.equal(store.saveFromQuickAsNew('Unchecked while owner available'),true);
+assert.equal(store.snapshot().saved.at(-1).roomSettings,null,'default OFF must not capture room settings');
+assert.equal(store.saveFromQuickAsNew('With Room Settings',true),true);
+const savedId=store.snapshot().saved.at(-1).id;
+assert.equal(store.snapshot().saved.at(-1).roomSettings.nParamsUI.gridTuning,'17edo');
+assert.equal(store.snapshot().saved.at(-1).roomSettings.wave.preset,'tape_halo');
+owner.nParamsUI={gridTuning:'31edo',droneMixVolume:.91};
+assert.equal(store.updateSavedFromQuick(savedId,'With Room Settings',false),true);
+assert.equal(store.snapshot().saved.find(x=>x.id===savedId).roomSettings.nParamsUI.gridTuning,'17edo','unchecked Update preserves stored settings');
