diff --git a/styles/27_meta_menu.css b/styles/27_meta_menu.css
new file mode 100644
index 0000000..57544c5
--- /dev/null
+++ b/styles/27_meta_menu.css
@@ -0,0 +1,250 @@
+/* 🎧 Meta-Menu: the approved Tabbed Library (A). Only session references here. */
+.xen-meta-rack{display:inline-flex;align-items:center;height:24px;max-width:132px;min-width:0;flex:0 1 auto;white-space:nowrap;border:1px solid #336879;border-radius:3px;padding:2px 5px;background:#0e2531;color:#bceaf4;font-size:11px;font-weight:600}
+.xen-meta-rack:hover,.xen-meta-rack:focus-visible{border-color:#47cde7;background:#123b4b}
+.xen-meta-overlay{position:fixed;inset:0;z-index:170;display:flex;align-items:center;justify-content:center;padding:16px;background:#000c;overflow:auto}
+.xen-meta-editor{display:flex;flex-direction:column;min-height:0;height:min(690px,calc(100dvh - 32px));max-height:calc(100dvh - 32px);width:min(1370px,calc(100vw - 32px));background:#0d1723;color:#dcecf8;border:1px solid #334c61;box-shadow:0 25px 70px #000c;font-size:12px}
+.xen-meta-editor button,.xen-meta-editor select,.xen-meta-editor input{font:inherit}.xen-meta-editor button{cursor:pointer}.xen-meta-editor button:disabled{opacity:.45;cursor:default}
+.xen-meta-editor button:focus-visible,.xen-meta-editor input:focus-visible,.xen-meta-editor select:focus-visible{outline:2px solid #44d9eb;outline-offset:2px}
+.xen-meta-titlebar{display:flex;align-items:center;gap:14px;padding:10px 15px;border-bottom:1px solid #31465b;background:#0c1520;min-height:43px}
+.xen-meta-titlebar strong{font-size:15px;color:#e0f6ff}.xen-meta-caption{font-size:10px;color:#819db0;letter-spacing:.02em}.xen-meta-titlebar button{margin-left:auto;font-size:20px;line-height:1;background:transparent;border:0;color:#bacfda;padding:2px 9px}
+.xen-meta-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;min-height:58px;padding:12px 14px;background:#121f2e;border-bottom:1px solid #33465a}
+.xen-meta-small-label{color:#91adc1;font-size:10px;letter-spacing:.13em}.xen-meta-toolbar input,.xen-meta-toolbar select{background:#0b1420;border:1px solid #455d74;color:#dcecf8;padding:7px 9px;min-width:0}
+.xen-meta-toolbar input{width:min(22vw,265px);min-width:130px}.xen-meta-toolbar select{width:210px}.xen-meta-toolbar button,.xen-meta-footer>button{border:1px solid #43576d;background:#1d2a3a;color:#cfdeee;padding:7px 10px}
+.xen-meta-toolbar button:hover,.xen-meta-footer>button:hover{background:#2d4158}.xen-meta-toolbar button:nth-last-of-type(1){background:#32c3d7;border-color:#32c3d7;color:#041822;font-weight:800}
+.xen-meta-dirty{font:10px ui-monospace,SFMono-Regular,monospace;color:#edc47b;white-space:nowrap}.xen-meta-live{font:10px ui-monospace,monospace;color:#94acbc;white-space:nowrap}
+.xen-meta-workspace{display:grid;grid-template-columns:minmax(335px,39fr) minmax(500px,61fr);min-height:0;flex:1 1 auto;overflow:hidden}
+.xen-meta-library{min-width:0;display:flex;flex-direction:column;overflow:hidden;background:#101c2a;border-right:1px solid #35516b}
+.xen-meta-constellation{min-width:0;display:flex;flex-direction:column;overflow:hidden;padding:0 14px 10px;background:#0c1522}
+.xen-meta-head{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:57px;padding:13px 15px 11px;color:#e4edf8}.xen-meta-head strong{font-size:14px}.xen-meta-head small{font:10px ui-monospace,monospace;color:#9bacc2;letter-spacing:.11em}
+.xen-meta-constellation .xen-meta-head{padding-left:2px;padding-right:0}
+/* These are actual connected file-folder tabs, not a row of unrelated pills. */
+.xen-meta-tabs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));padding:0 13px;gap:3px;position:relative;margin-bottom:-1px;z-index:1}
+.xen-meta-tabs>button{display:flex;gap:4px;align-items:center;justify-content:center;padding:10px 4px 9px;background:#152435;border:1px solid #304860;border-bottom-color:#456077;border-radius:7px 7px 0 0;color:#9db3c6;white-space:nowrap;font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis}
+.xen-meta-tabs>button[aria-selected=true]{background:#0d1d2c;border-color:#4ab4cd;border-bottom:1px solid #0d1d2c;color:#d9faff;transform:translateY(1px);z-index:2}
+.xen-meta-browser{display:flex;flex-direction:column;min-height:0;margin:0 13px 13px;border:1px solid #334f66;background:#0d1d2c;flex:1}
+.xen-meta-browser-heading{display:flex;align-items:center;gap:8px;padding:10px 11px;border-bottom:1px solid #304456;min-height:40px}.xen-meta-browser-heading strong{margin-right:auto;font-weight:700;white-space:nowrap}.xen-meta-browser-heading input{min-width:0;width:130px;background:#0c1622;border:1px solid #344d62;padding:5px 7px;color:#dcecf8}.xen-meta-browser-heading span{font:10px ui-monospace,monospace;white-space:nowrap;color:#9cb6c8}
+.xen-meta-library-list{min-height:0;max-height:none;flex:1 1 auto;overflow:auto;padding:10px;scrollbar-width:thin}
+.xen-meta-library-row{height:51px;display:flex;align-items:center;gap:11px;margin-bottom:7px;padding:7px 10px;border:1px solid #35516a;background:#162638;color:#d3e5ef;cursor:grab;user-select:none}
+.xen-meta-library-row:hover{background:#20354a;border-color:#468aaa}.xen-meta-source-icon{font-size:16px;flex:0 0 19px}.xen-meta-source-name{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}.xen-meta-library-row button{flex:0 0 27px;width:27px;height:28px;border:1px solid #41657f;background:#122e40;color:#91e4f1;font-size:16px}
+.xen-meta-library-row button:hover{background:#235468}.xen-meta-empty-library{margin:12px;color:#93abc0;font-size:11px;line-height:1.5}
+.xen-meta-helper{font-size:10px;color:#8da3ba;padding:0 0 10px}
+.xen-meta-board{display:grid;grid-template-columns:repeat(5,minmax(108px,1fr));gap:7px;min-height:0;max-height:none;padding:9px;border:1px solid #364b62;background:#0a1320;overflow:auto;flex:1}
+.xen-meta-lane{min-width:0;min-height:0;background:#0d1b2a;border:1px solid #2d4159;padding:4px;transition:background .12s,border-color .12s}
+.xen-meta-lane>header{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:51px;line-height:1.4;color:#d9e8f3;text-align:center}
+.xen-meta-lane>header strong{font:700 11px ui-monospace,monospace}.xen-meta-lane>header small{font-size:10px;color:#8fa9bf}
+.xen-meta-lane-items{display:flex;flex-direction:column;gap:5px;min-height:205px}
+.xen-meta-tile{display:flex;align-items:center;gap:5px;width:100%;min-height:38px;max-height:38px;padding:5px 4px;border:1px solid #42617c;background:#1b3042;color:#d8edfd;text-align:left;cursor:grab;user-select:none}
+.xen-meta-tile:hover{background:#294b64;border-color:#61b1d3}
+.xen-meta-tile-index{font-size:10px;color:#92dff6;flex:0 0 12px}.xen-meta-tile-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:10px ui-monospace,SFMono-Regular,monospace;min-width:0}.xen-meta-tile.is-missing{border-color:#ca9259;color:#eecd96}
+.xen-meta-board.is-drop-hover{border-color:#32d6ec;background:#0b2432}
+.xen-meta-board.is-drop-hover .xen-meta-lane.is-drop-lane{background:#173648;border-color:#54d4ed}
+.xen-meta-board.is-drop-hover .xen-meta-lane.is-drop-lane .xen-meta-lane-items:after{content:'+ drop here';color:#6cddf5;font:10px ui-monospace,monospace;text-align:center;display:block;border-top:2px solid #43b4d1;padding-top:6px}
+.xen-meta-board-foot{display:flex;justify-content:flex-start;padding:8px 0;font-size:10px;color:#88a3b9}
+.xen-meta-footer{display:flex;gap:10px;align-items:center;flex-wrap:wrap;min-height:41px;padding:8px 14px;border-top:1px solid #35516a;background:#101d2b}
+.xen-meta-footer [role=status]{color:#96b3c7;font:10px ui-monospace,monospace;margin-left:auto}
+@media(max-width:1080px){.xen-meta-editor{width:calc(100vw - 14px)}.xen-meta-workspace{grid-template-columns:minmax(280px,42fr) minmax(375px,58fr)}.xen-meta-overlay{padding:7px}.xen-meta-board{grid-template-columns:repeat(5,minmax(110px,1fr))}.xen-meta-tabs{padding:0 7px}.xen-meta-tabs>button{font-size:10px;gap:2px}}
+@media(max-width:760px){.xen-meta-workspace{grid-template-columns:minmax(215px,43fr) minmax(0,57fr)}.xen-meta-constellation{padding:0 7px}.xen-meta-library-list{padding:5px}.xen-meta-tabs{gap:1px;padding:0 3px}.xen-meta-tabs>button{flex-direction:column;font-size:9px;padding:5px 1px}.xen-meta-browser{margin:0 4px 8px}.xen-meta-board{grid-template-columns:repeat(5,minmax(95px,1fr));min-height:280px}.xen-meta-toolbar{padding:8px 10px}.xen-meta-toolbar input{min-width:100px;width:145px}.xen-meta-toolbar select{width:165px}.xen-meta-caption,.xen-meta-live{display:none}}
+
+/* Contextual color chooser floats ABOVE the compact board; no added row or scroll region. */
+.xen-meta-constellation{position:relative}
+.xen-meta-tile.is-color-selected{outline:2px solid #b6eefa;outline-offset:1px}
+.xen-meta-color-editor{position:absolute;z-index:9;right:14px;top:55px;width:min(275px,calc(100% - 24px));box-sizing:border-box;padding:10px 12px;border:1px solid #55c4dc;background:#102535;box-shadow:0 15px 30px #000c;color:#e3f5fc;display:flex;flex-direction:column;gap:9px}
+.xen-meta-color-editor>header{display:flex;align-items:center;gap:6px;min-width:0}.xen-meta-color-editor>header strong{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
+.xen-meta-color-editor>header button{border:0;background:none;color:#e3f5fc;font-size:18px;padding:0 6px}
+.xen-meta-color-controls{display:flex;gap:14px}.xen-meta-color-controls label{flex:1;display:flex;align-items:center;justify-content:space-between;gap:7px;color:#b2d4e8}
+.xen-meta-color-controls input[type=color]{appearance:auto;inline-size:44px;block-size:30px;min-inline-size:44px;padding:2px;border:1px solid #45667b;background:#132536;cursor:pointer}
+.xen-meta-color-reset{align-self:start;padding:5px 9px;border:1px solid #466679;background:#182d40;color:#d5effb}
+.xen-meta-color-editor small{font-size:10px;color:#95b7ca;line-height:1.4}
+/* Live Quick Access receives only the explicitly activated Session's visual annotations.
+   Keypress pulse remains higher-priority feedback than decorative session colors. */
+.xen-quick-tile.is-session-tinted:not(.is-key-pulse){border-color:var(--xen-session-border);background:var(--xen-session-bg)}
+.xen-quick-tile.is-session-tinted:not(.is-key-pulse):hover{filter:brightness(1.20)}
+
+/* Disk is OUTSIDE the existing five mute buttons, with no new row or changed widths.
+   Left dock -> on its right; right (migrated) dock -> on its left. */
+.xen-quick-mutes-save{position:relative;min-width:0}
+.xen-quick-save-trigger{position:absolute;z-index:4;top:-3px;right:-28px;left:auto;width:23px;height:23px;display:grid;place-items:center;padding:0;border:1px solid #3f9770;border-radius:4px;background:#0c261a;color:#c0fadd;font-size:15px;line-height:1;cursor:pointer;box-shadow:0 2px 8px #0009}
+.xen-quick-collection.is-migrated .xen-quick-save-trigger{left:-28px;right:auto}
+.xen-quick-save-trigger:hover,.xen-quick-save-trigger:focus-visible{border-color:#86ebbf;background:#144a32}
+.xen-quick-save-trigger:focus-visible{outline:2px solid #adffdc;outline-offset:2px}
+.xen-quick-save-overlay{position:fixed;inset:0;z-index:250;display:flex;align-items:center;justify-content:center;background:#000c;padding:14px}
+.xen-quick-save-dialog{box-sizing:border-box;display:flex;flex-direction:column;gap:12px;width:min(425px,calc(100vw - 28px));padding:15px 17px;border:1px solid #407a8d;background:#101c2c;color:#d9f3ff;box-shadow:0 18px 55px #000c;font-size:12px}
+.xen-quick-save-dialog>header{display:flex;align-items:center;justify-content:space-between;gap:15px;font-size:15px}
+.xen-quick-save-dialog>header button{background:transparent;border:0;color:#d9f3ff;font-size:20px;cursor:pointer}
+.xen-quick-save-dialog p{margin:0;color:#a7c1d1}
+.xen-quick-save-dialog label{display:grid;gap:5px}
+.xen-quick-save-dialog label>span{font-size:11px;color:#86c9dd}
+.xen-quick-save-dialog input,.xen-quick-save-dialog select{width:100%;box-sizing:border-box;padding:8px;border:1px solid #49657d;background:#081727;color:#e9f8ff;font:inherit}
+.xen-quick-save-dialog .xen-quick-save-include-settings{display:flex;align-items:center;gap:9px;cursor:pointer;min-height:26px}
+.xen-quick-save-dialog .xen-quick-save-include-settings input{width:16px;height:16px;flex:0 0 16px;padding:0;margin:0;accent-color:#57c8b4;cursor:pointer}
+.xen-quick-save-dialog .xen-quick-save-include-settings span{color:#d9f3ff;font-size:12px}
+.xen-quick-save-actions{display:flex;gap:8px;flex-wrap:wrap}
+.xen-quick-save-actions button{flex:1 1 145px;min-height:34px;border:1px solid #54718c;background:#20374b;color:#d9f3ff;padding:7px 10px;font-size:12px;cursor:pointer}
+.xen-quick-save-actions .is-new{border-color:#43ac9d;background:#134b47}
+.xen-quick-save-actions button:disabled{opacity:.35;cursor:default}
+.xen-quick-save-dialog .xen-quick-save-error{color:#ffb4b4;line-height:1.35}
+
+/* P7.26: wider dual-color frames without altering tile outer box dimensions. */
+.xen-meta-tile{box-sizing:border-box;border-width:3px;padding:3px 2px}
+.xen-quick-tile.is-session-tinted{box-sizing:border-box;border-width:3px}
+/* P7.26: only the selected live source gets larger typography, never a bigger tile footprint. */
