+.xen-meta-library-row .xen-meta-row-preview:hover:not(:disabled){background:#235468}
+@media(max-width:760px){.xen-meta-browser-heading .xen-meta-library-open-manager{flex-basis:188px;width:min(188px,100%)}}
+/* At narrow widths the fixed-width violet link may wrap the Filter to a
