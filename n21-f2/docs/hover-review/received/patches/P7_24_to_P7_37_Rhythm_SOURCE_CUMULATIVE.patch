+assert.equal(JSON.stringify(store.snapshot().saved),beforeJSON,'failed capture must not modify session');
+assert.equal(store.saveFromQuickAsNew('No Owner Checked',true),false,'checked create must not save a partial session');
+assert.equal(store.updateSavedFromQuick(savedId,'With Room Settings',false),true,'unchecked update must work without Main Room owner');
+assert.equal(store.snapshot().saved.find(x=>x.id===savedId).roomSettings.nParamsUI.gridTuning,'31edo');
+console.log('PASS meta-save-from-quick: create/update, collision, tint inheritance, optional settings, preservation, failed-capture rollback');
