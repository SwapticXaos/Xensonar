+.xen-meta-tab-assembly{position:relative;margin:0 13px 0;padding-top:35px;min-width:0;isolation:isolate}
+.xen-meta-session-backtab{position:absolute;z-index:0;cursor:pointer;top:0;left:0;right:0;height:39px;box-sizing:border-box;display:flex;justify-content:center;align-items:flex-start;padding:5px 11px 0;border:1px solid #366a84;border-bottom:0;border-radius:9px 9px 0 0;background:linear-gradient(180deg,#18384d 0%,#142b3e 75%,#102536 100%);color:#ade5f3;font:700 12px/20px system-ui,sans-serif;letter-spacing:.035em}
