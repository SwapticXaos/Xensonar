+/* History lives in the existing footer, after the informational status. */
+.xen-meta-footer-status{flex:1 1 160px;min-width:0}
+.xen-meta-history-controls{display:flex;align-items:center;gap:6px;margin-left:auto;flex:0 0 auto}
