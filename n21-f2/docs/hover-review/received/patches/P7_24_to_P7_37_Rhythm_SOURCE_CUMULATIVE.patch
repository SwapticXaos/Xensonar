+@media(max-width:760px){.xen-meta-tab-assembly{margin:0 4px 0;padding-top:35px}.xen-meta-session-backtab{height:39px;padding:5px 8px 0}.xen-meta-tab-assembly>.xen-meta-tabs{gap:1px}.xen-meta-tab-assembly>.xen-meta-tabs>button{min-height:39px}}
